---
import { DocLayout } from '@instancedeck/ui/marketing';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadReleases } from '../../lib/releases';
import { absoluteUrl } from '../../lib/urls';
import type { Graph } from 'schema-dts';
const releases = await loadReleases();
const schema: Graph = { '@context': 'https://schema.org', '@graph': [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl() }, { '@type': 'ListItem', position: 2, name: 'Changelog', item: absoluteUrl('changelog/') }] }] };
---
<SiteLayout title="Changelog – InstanceDeck" description="Read InstanceDeck's published GitHub release notes and version history, fetched when this static site is built." schema={schema} ogSlug="changelog">
  <DocLayout title="InstanceDeck changelog" intro="Published release notes, fetched from GitHub when this site is built." breadcrumbs={[{ label: 'Changelog' }]} linkPrefix="../">
    {releases.length ? releases.map((release) => <section><h2><a href={release.html_url}>{release.name || release.tag_name}</a></h2><p>{release.published_at.slice(0, 10)}{release.prerelease ? ' · Prerelease' : ''}</p><pre>{release.body || 'Read the release on GitHub for its artifacts.'}</pre></section>) : <><h2>No releases have been published yet.</h2><p>Development progress is recorded in the public repository. This page will list actual release notes after publication.</p><p><a href="https://github.com/tanzir71/instancedeck/blob/main/PROGRESS.md">Read development progress</a></p></>}
    <p><a href="../download/">Download status</a> · <a href="../code-signing-policy/">Signing policy</a></p>
  </DocLayout>
</SiteLayout>
