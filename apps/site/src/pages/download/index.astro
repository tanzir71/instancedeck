---
import { ButtonLink } from '@instancedeck/ui/button';
import { DocLayout } from '@instancedeck/ui/marketing';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadReleases } from '../../lib/releases';
import { absoluteUrl, sourceUrl } from '../../lib/urls';
import type { Graph } from 'schema-dts';
const releases = await loadReleases();
const latest = releases.find((release) => !release.prerelease);
const downloads = latest?.assets.filter((asset) => /(?:\.exe|\.zip)$/i.test(asset.name)) ?? [];
const checksums = latest?.assets.find((asset) => /sha256|checksums/i.test(asset.name));
const schema: Graph = { '@context': 'https://schema.org', '@graph': [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl() }, { '@type': 'ListItem', position: 2, name: 'Download', item: absoluteUrl('download/') }] }] };
---
<SiteLayout title="Download for Windows – InstanceDeck" description="Find InstanceDeck's published Windows installers, portable packages, SHA-256 checksums and current signing status." schema={schema} ogSlug="download">
  <DocLayout title="Download InstanceDeck for Windows" intro="Install the launcher, then use the official apps you already have." breadcrumbs={[{ label: 'Download' }]} linkPrefix="../">
    {latest ? <>
      <h2>{latest.tag_name}</h2><p>Published {latest.published_at.slice(0, 10)}. Check your Windows architecture before choosing a package.</p>
      {downloads.length ? <ul>{downloads.map((asset) => <li><a href={asset.browser_download_url}>{asset.name}</a> · {(asset.size / 1024 / 1024).toFixed(1)} MiB</li>)}</ul> : <p>This release has no Windows installer or portable package attached yet.</p>}
      {checksums ? <p><a href={checksums.browser_download_url}>Download SHA-256 checksums</a></p> : <p>Checksums are not attached to this release. Wait for the complete release artifacts before installing.</p>}
      <p><a href={latest.html_url}>Read the release notes on GitHub</a></p>
    </> : <>
      <h2>No public release is available yet.</h2><p>InstanceDeck is in development. Installers and portable packages will appear here after a release is published. Source code and build instructions are available now.</p>
      <ButtonLink href={sourceUrl}>View source on GitHub</ButtonLink>
    </>}
    <h2>Requirements</h2><p>Windows 10 22H2 or later, or Windows 11. x64 and ARM64 are target architectures; native x64 development builds have been tested. Install the official target apps separately.</p>
    <h2>Signing and SmartScreen</h2><p>Releases are unsigned. Windows may warn or block installation. Check the source and SHA-256 checksum; do not disable Windows protection to install an untrusted file.</p>
    <h2>Verify integrity</h2><p>Download the checksum file from the same release, then compare it with PowerShell's result:</p><pre><code>Get-FileHash -Algorithm SHA256 -LiteralPath '.\your-downloaded-file.exe'</code></pre>
    <p><a href="../code-signing-policy/">Code signing policy</a> · <a href="../security/">Security model</a> · <a href="../changelog/">Changelog</a></p>
  </DocLayout>
</SiteLayout>
