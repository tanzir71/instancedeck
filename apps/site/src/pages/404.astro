---
import { DocLayout } from '@instancedeck/ui/marketing';
import SiteLayout from '../layouts/SiteLayout.astro';
import { absoluteUrl } from '../lib/urls';
---
<SiteLayout title="Page Not Found – InstanceDeck" description="Find InstanceDeck downloads, app compatibility, guides and answers." noindex ogSlug="404" canonicalPath="404.html" linkPrefix={absoluteUrl()}>
  <DocLayout title="This page is not in the deck." intro="Try one of these starting points." breadcrumbs={[{ label: 'Page not found' }]} linkPrefix={absoluteUrl()}>
    <ul><li><a href={absoluteUrl()}>Home</a></li><li><a href={absoluteUrl('apps/')}>App compatibility</a></li><li><a href={absoluteUrl('download/')}>Download status</a></li><li><a href={absoluteUrl('faq/')}>Questions and answers</a></li></ul>
  </DocLayout>
</SiteLayout>
