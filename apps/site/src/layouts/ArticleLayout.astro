---
import { DocLayout } from '@instancedeck/ui/marketing';
import SiteLayout from './SiteLayout.astro';
import { absoluteUrl, relativePrefix } from '../lib/urls';
import type { Graph } from 'schema-dts';
interface Props { frontmatter: { title: string; description: string; heading: string; name: string; intro?: string; noindex?: boolean; }; }
const { frontmatter: page } = Astro.props;
const prefix = relativePrefix(Astro.url.pathname);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/+$/, ''), '').replace(/^\/+|\/+$/g, '');
const schema: Graph = {
  '@context': 'https://schema.org',
  '@graph': [{ '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl() },
    { '@type': 'ListItem', position: 2, name: page.name, item: absoluteUrl(`${path}/`) },
  ] }],
};
---
<SiteLayout title={page.title} description={page.description} schema={schema} noindex={page.noindex} ogSlug={path.replaceAll('/', '-')}>
  <DocLayout title={page.heading} intro={page.intro} eyebrow={page.name} breadcrumbs={[{ label: page.name }]} linkPrefix={prefix}>
    <slot />
  </DocLayout>
</SiteLayout>
