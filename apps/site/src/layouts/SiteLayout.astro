---
import { SiteHeader, MarketingFooter } from '@instancedeck/ui/marketing';
import '@instancedeck/ui/styles';
import { absoluteUrl, relativePrefix } from '../lib/urls';
import type { Graph } from 'schema-dts';
import { serifFont, sansFont } from '@instancedeck/ui/fonts';
import favicon from '../../../../design/assets/logo-mark.svg?url';

interface Props { title: string; description: string; noindex?: boolean; schema?: Graph; ogSlug?: string; canonicalPath?: string; linkPrefix?: string; }
const { title, description, noindex = false, schema, ogSlug = 'home', canonicalPath } = Astro.props;
const pagePath = canonicalPath ?? Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/+$/, ''), '').replace(/^\/+/, '');
const canonical = absoluteUrl(pagePath);
const prefix = Astro.props.linkPrefix ?? relativePrefix(`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/${pagePath}`);
const og = absoluteUrl(`og/${ogSlug}.png`);
const structured: Graph = schema ?? { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: title, description, url: canonical },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl() }, { '@type': 'ListItem', position: 2, name: title, item: canonical }] },
] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="sitemap" href={absoluteUrl('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="InstanceDeck" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — InstanceDeck profile cards`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {import.meta.env.PUBLIC_GSC_TOKEN && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_TOKEN} />}
    {import.meta.env.PUBLIC_BING_TOKEN && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_TOKEN} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader linkPrefix={prefix} />
    <slot />
    <MarketingFooter linkPrefix={prefix} />
    <script>
      import { keepDialogFocus } from '@instancedeck/ui/dialog-focus';
      const opener = document.querySelector<HTMLButtonElement>('[data-site-menu-open]');
      const dialog = document.querySelector<HTMLDialogElement>('header dialog');
      const header = opener?.closest('header');
      const updateHeader = () => header?.toggleAttribute('data-scrolled', window.scrollY > 0);
      window.addEventListener('scroll', updateHeader, { passive: true });
      updateHeader();
      if (opener && dialog) {
        opener.addEventListener('click', () => dialog.showModal());
        dialog.querySelector('[data-site-menu-close]')?.addEventListener('click', () => dialog.close());
        dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => dialog.close()));
        dialog.addEventListener('keydown', (event) => keepDialogFocus(dialog, event));
        dialog.addEventListener('close', () => opener.focus());
      }
    </script>
  </body>
</html>
<style>
  .skip-link { position: fixed; top: 8px; left: 8px; transform: translateY(-200%); padding: 12px 20px; background: var(--paper); color: var(--accent); z-index: 10; }
  .skip-link:focus { transform: none; }
</style>
