{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstanceDeck",
  "version": "0.1.0",
  "identifier": "com.tanziro.instancedeck",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InstanceDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "visible": false
      },
      {
        "label": "switcher",
        "title": "InstanceDeck switcher",
        "url": "index.html",
        "width": 640,
        "height": 420,
        "minWidth": 520,
        "minHeight": 300,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tanzir Rahman",
    "homepage": "https://tanzir71.github.io/instancedeck/",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "InstanceDeck"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NUQ5Q0I4MjFDNjY2NTQKUldSVVpzWWh1SnhkeVNUeDZZWU55ODFINHo1NjhGbTlwZEFYMEh2M1RydlkreHRLUUdhdkR4RmkK",
      "endpoints": [
        "https://github.com/tanzir71/instancedeck/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
