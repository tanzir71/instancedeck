{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstanceDeck",
  "version": "0.1.0",
  "identifier": "com.tanziro.instancedeck",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InstanceDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "targets": "nsis" }
}
